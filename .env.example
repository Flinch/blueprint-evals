# Copy to .env and fill in. .env is gitignored and never committed.
# Read automatically by `npm run evals`, `npm run ui` and `npm run health-bot`
# when they are run from this folder. Values in this file win over anything
# already exported in your shell. A blank value is ignored.

# Your Anthropic API key (starts with sk-ant-).
ANTHROPIC_API_KEY=

# Pins the API address. Fixes a stale proxy URL left in a terminal, such as
# http://127.0.0.1:6767, which sends calls to the wrong place.
ANTHROPIC_BASE_URL=https://api.anthropic.com
