{
  "name": "blueprint-evals",
  "version": "0.0.0",
  "description": "An open-source framework for testing AI agents: simulated users, auditable graders, calibrated LLM judges.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "evals": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "stub-agent": "tsx examples/stub-agent/serve.ts",
    "health-bot": "tsx examples/health-bot/serve.ts",
    "evals": "tsx src/cli/index.ts",
    "ui": "tsx src/cli/index.ts ui",
    "ui:demo": "npm run build:ui && tsx scripts/seed-demo.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flinch/blueprint-evals.git"
  },
  "keywords": [
    "llm",
    "evals",
    "agents",
    "testing",
    "llm-as-judge",
    "ai-testing"
  ],
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}
