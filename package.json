{
  "name": "blueprint-evals",
  "version": "0.0.0",
  "description": "An open-source framework for testing AI agents: simulated users, auditable graders, calibrated LLM judges.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "evals": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stub-agent": "tsx examples/stub-agent/serve.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flinch/blueprint-evals.git"
  },
  "keywords": [
    "llm",
    "evals",
    "agents",
    "testing",
    "llm-as-judge",
    "ai-testing"
  ],
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
